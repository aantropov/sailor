<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="this"
             x:Class="SailorEditor.Views.ToolbarView">
    <ContentView.Resources>
        <Style TargetType="ImageButton">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="BorderWidth" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HeightRequest" Value="32"/>
            <Setter Property="WidthRequest" Value="32"/>
            <Setter Property="MinimumHeightRequest" Value="32"/>
            <Setter Property="MinimumWidthRequest" Value="32"/>
            <Setter Property="Aspect" Value="AspectFit"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
    </ContentView.Resources>

    <Border StrokeThickness="1" Stroke="#363A40" BackgroundColor="#202328"
            Padding="8,4" StrokeShape="RoundRectangle 0">
        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="16">
            <HorizontalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Start">
                <ImageButton Source="toolbar_save.png"
                             ToolTipProperties.Text="Save Scene" SemanticProperties.Description="Save Scene"
                             Clicked="OnSaveButtonClicked"/>
                <ImageButton Source="toolbar_undo.png"
                             ToolTipProperties.Text="Undo" SemanticProperties.Description="Undo"
                             Clicked="OnUndoButtonClicked"/>
                <ImageButton Source="toolbar_redo.png"
                             ToolTipProperties.Text="Redo" SemanticProperties.Description="Redo"
                             Clicked="OnRedoButtonClicked"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                <ImageButton Source="toolbar_play.png"
                             ToolTipProperties.Text="Play" SemanticProperties.Description="Play"
                             Clicked="OnPlayButtonClicked"/>
                <ImageButton Source="toolbar_debug.png"
                             ToolTipProperties.Text="Debug Play" SemanticProperties.Description="Debug Play"
                             Clicked="OnPlayDebugButtonClicked"/>
                <ImageButton x:Name="SimulationButton" Source="toolbar_simulate.png"
                             ToolTipProperties.Text="Simulate" SemanticProperties.Description="Simulate"
                             Clicked="OnSimulationButtonClicked"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="End">
                <ImageButton Source="toolbar_trace_scene.png"
                             ToolTipProperties.Text="Trace Scene" SemanticProperties.Description="Trace Scene"
                             Clicked="OnPathTraceSceneButtonClicked"/>
                <ImageButton Source="toolbar_trace_selection.png"
                             ToolTipProperties.Text="Trace Selection" SemanticProperties.Description="Trace Selection"
                             Clicked="OnPathTraceSelectionButtonClicked"/>
                <ImageButton Source="toolbar_save_layout.png"
                             ToolTipProperties.Text="Save Layout" SemanticProperties.Description="Save Layout"
                             Clicked="OnSaveLayoutButtonClicked"/>
                <ImageButton Source="toolbar_reset_layout.png"
                             ToolTipProperties.Text="Reset Layout" SemanticProperties.Description="Reset Layout"
                             Clicked="OnResetLayoutButtonClicked"/>
                <ImageButton Source="toolbar_settings.png"
                             ToolTipProperties.Text="Settings" SemanticProperties.Description="Settings"
                             Clicked="OnSettingsButtonClicked"/>
            </HorizontalStackLayout>
        </Grid>
    </Border>
</ContentView>