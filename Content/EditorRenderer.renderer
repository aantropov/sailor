---
samplers:
- name: g_defaultSampler
  fileId: ''
  path: Textures/VulkanLogo.png

- name: g_lensDirtSampler
  fileId: ''
  path: Textures/Bokeh__Lens_Dirt_9.jpg 

- name: g_ditherPatternSampler
  fileId: ''
  path: Textures/DitherPattern.png

- name: g_noiseSampler
  fileId: ''
  path: Textures/Noise.png

float:
- PI: 3.1415926
  
############################
renderTargets:
- name: DepthBuffer
  format: D32_SFLOAT_S8_UINT
  width: RenderWidth
  height: RenderHeight

- name: OverlayDepthBuffer
  format: D32_SFLOAT_S8_UINT
  width: ViewportWidth
  height: ViewportHeight

- name: Main
  format: R16G16B16A16_SFLOAT
  width: RenderWidth
  height: RenderHeight
  bIsSurface: true
  bIsCompatibleWithComputeShaders: true
  bGenerateMips: true
  maxMipLevel: 8

- name: Secondary
  format: R16G16B16A16_SFLOAT
  width: RenderWidth
  height: RenderHeight
  bIsSurface: false
  bGenerateMips: true

- name: AverageLuminance
  format: R32_SFLOAT
  filtration: Nearest
  clamping: Clamp
  width: 1
  height: 1
  bIsCompatibleWithComputeShaders: true

- name: EditorOutput
  format: B8G8R8A8_SRGB
  width: ViewportWidth
  height: ViewportHeight
  bIsSurface: false

- name: Sky
  format: R16G16B16A16_SFLOAT
  width: RenderWidth
  height: RenderHeight
  clamping: Clamp
  bIsSurface: false

- name: HalfDepth
  format: D32_SFLOAT_S8_UINT
  width: RenderWidth/2
  height: RenderHeight/2

- name: GlobalIlluminationProbeCellIndices
  format: R32G32B32A32_SFLOAT
  filtration: Nearest
  clamping: Clamp
  width: RenderWidth/2
  height: RenderHeight/2
  bIsCompatibleWithComputeShaders: true
  
- name: DepthHighZ
  format: R32_SFLOAT
  width: RenderWidth/2
  height: RenderHeight/2
  bIsCompatibleWithComputeShaders: true
  bGenerateMips: true
  reduction: Min

- name: AO
  format: R8_UNORM
  width: RenderWidth/2
  height: RenderHeight/2

- name: TemporaryR8
  format: R8_UNORM
  width: RenderWidth
  height: RenderHeight

- name: g_AO
  format: R8_UNORM
  width: RenderWidth
  height: RenderHeight
  
- name: QuarterMain1
  format: R16G16B16A16_SFLOAT
  width: 512
  height: 512
  
- name: QuarterMain2
  format: R16G16B16A16_SFLOAT
  width: 512
  height: 512
  bIsSurface: false
  
- name: LinearDepth
  format: R32_SFLOAT
  filtration: Nearest
  width: RenderWidth
  height: RenderHeight
  bIsSurface: false

############################
frame:
############################

- name: Clear
  float:
  - clearDepth: 0
  - clearStencil: 0
  renderTargets:
  - target: DepthBuffer

- name: DepthPrepass
  string:
  - Tag: Opaque
  - ClearDepth: true
  - GPUCulling: false
  - VirtualizeInstancePayloads: true
  renderTargets:
  - depthStencil: DepthBuffer
  - depthHighZ: DepthHighZ

- name: DepthPrepass
  string:
  - Tag: Masked
  - GPUCulling: false
  - VirtualizeInstancePayloads: true
  renderTargets:
  - depthStencil: DepthBuffer
  - depthHighZ: DepthHighZ
 
############################
- name: LinearizeDepth
  renderTargets:
  - depthStencil: DepthBuffer
  - target: LinearDepth
  
############################
- name: LightCulling
############################
  renderTargets:
  - linearDepth: LinearDepth

############################
- name: Clear
############################
  vec4:
  - clearColor: [1.502, 2.08, 2.61, 2.5]
  renderTargets:
  - target: Main

############################
- name: ShadowPrepass
############################
  string:
  - VirtualizeInstancePayloads: true

############################
- name: Sky
############################
  renderTargets:
  - color: Sky
  - linearDepth: LinearDepth

############################
- name: Environment
#  string:
#  - EnvironmentMap: Textures/Environment.hdr
############################

#############################
#- name: PostProcess
############################
#  string:
#  - shader: Shaders/Blur.shader
#  - defines: RADIAL
#  vec4:
#  - data.blurRadius: [20, 0, 0, 0]
#  - data.blurSampleCount: [10, 0, 0, 0]
#  - data.blurCenter: [0.5, 0.5, 0, 0]
#  renderTargets:
#  - colorSampler: Sky
#  - color: Main

#############################
#- name: PostProcess
############################
#  string:
#  - shader: Shaders/Blur.shader
#  - defines: HORIZONTAL
#  vec4:
#  - data.blurRadius: [4, 2, 0, 0]
#  renderTargets:
#  - colorSampler: Secondary
#  - color: Main
  
#############################
#- name: PostProcess
#############################
#  string:
#  - shader: Shaders/Sky.shader
#  - defines: FILL
#  vec4:
#  - data.param: [0.0225, 0.00345, 0.00455, 0.0]
#  renderTargets:
#  - color: Sky
 
############################
- name: Blit
############################
  renderTargets:
  - src: Sky
  - dst: Main
  
############################
# HBAO
############################
- name: Blit
############################
  renderTargets:
  - src: DepthBuffer
  - dst: HalfDepth

############################
# DepthHighZ
############################
- name: DepthHighZ
############################
  renderTargets:
  - src: HalfDepth
  - dst: DepthHighZ

############################
- name: GlobalIlluminationResolve
############################
  renderTargets:
  - depthSampler: DepthBuffer
  - probeCellIndices: GlobalIlluminationProbeCellIndices
  
############################
- name: PostProcess
############################
  string:
  - shader: Shaders/HBAO.shader
  - defines: ~
  float:
  - data.occlusionRadius: 1.5
  - data.occlusionPower: 1.5
  - data.occlusionAttenuation: 1
  - data.occlusionBias: 0.25
  - data.noiseScale: 25
  - data.normalBias: 0.15
  renderTargets:
  - color: AO
  - depthSampler: HalfDepth
  - noiseSampler: g_noiseSampler

############################
- name: PostProcess
############################
  string:
  - shader: Shaders/HBAO_Blur.shader
  - defines: VERTICAL
  float:
  - data.sharpness: 0.5
  - data.distanceScale: 2
  - data.radius: 5
  renderTargets:
  - color: TemporaryR8
  - aoSampler: AO
  - depthSampler: DepthBuffer

############################
- name: PostProcess
############################
  string:
  - shader: Shaders/HBAO_Blur.shader
  - defines: HORIZONTAL
  float:
  - data.sharpness: 0.5
  - data.distanceScale: 2
  - data.radius: 5
  renderTargets:
  - color: g_AO
  - aoSampler: TemporaryR8
  - depthSampler: DepthBuffer

############################
- name: RenderScene
############################
  string:
  - Tag: Opaque
  - GPUCulling: true
  - OcclusionCulling: true
  - VirtualizeInstancePayloads: true
  renderTargets:
  - color: Main
  - depthStencil: DepthBuffer
  - depthHighZ: DepthHighZ
  - globalIlluminationProbeCellIndicesSampler: GlobalIlluminationProbeCellIndices

############################
- name: CPUPathTracerNode
############################
  float:
  - enabled: 1
  - samplesPerFrame: 1
  - maxBounces: 2
  - blend: 1
  - maxAccumulatedSamples: 32
  renderTargets:
  - color: Main
  
############################
- name: RenderScene
############################
  string:
  - Tag: Masked
  - GPUCulling: true
  - OcclusionCulling: true
  - VirtualizeInstancePayloads: true
  renderTargets:
  - color: Main
  - depthStencil: DepthBuffer
  - depthHighZ: DepthHighZ
  - globalIlluminationProbeCellIndicesSampler: GlobalIlluminationProbeCellIndices

############################
- name: Blit
############################
  string:
  - GenerateMips: true
  renderTargets:
  - src: Main
  - dst: Secondary

############################
- name: RenderScene
############################
  string:
  - Tag: Transparent
  - Sorting: BackToFront
  - GPUCulling: false
  - VirtualizeInstancePayloads: true
  renderTargets:
  - color: Main
  - depthStencil: DepthBuffer
  - depthHighZ: DepthHighZ
  - transmissionFramebuffer: Secondary

############################
- name: PostProcess
############################
  string:
  - shader: Shaders/MotionBlur.shader
  - defines: ~
  float:
  - data.intensity: 1
  - data.samples: 10
  - data.maxSpeed: 50
  renderTargets:
  - color: Secondary
  - depthSampler: DepthBuffer
  - colorSampler: Main

############################
- name: Blit
############################
  renderTargets:
  - src: Secondary
  - dst: Main

############################
- name: RenderScene
############################
  string:
  - Tag: Viewmodel
  - GPUCulling: false
  - VirtualizeInstancePayloads: true
  renderTargets:
  - color: Main
  - depthStencil: DepthBuffer
  - depthHighZ: DepthHighZ

#############################
- name: EyeAdaptation
#############################
  vec4:
  - metering: [1.5, 0.45, 0.98, 0.0]
  - adaptation: [0.0, 16.0, 3.6, 1.2]
  renderTargets:
  - hdrColor: Main
  - averageLuminance: AverageLuminance

##############################
- name: Bloom
##############################
  vec4:
  - bloomIntensity: [0.35, 0, 0, 0]
  - scatter: [0.65, 0, 0, 0]
  - dirtIntensity: [0.75, 0, 0, 0]
  - threshold: [3.0, 0, 0, 0]
  - knee: [0.2, 0, 0, 0]
  renderTargets:
  - bloom: Main
  - averageLuminanceSampler: AverageLuminance

#############################
- name: PostProcess
  tag: Tonemapping
#############################
  string:
  - shader: Shaders/Tonemapping.shader
  - defines: AGX
  vec4:
  - data.exposureCompensation: [0.15, 0, 0, 0]
  - data.whitePoint: [11.2, 11.2, 11.2, 0]
  renderTargets:
  - color: Secondary
  - colorSampler: Main
  - averageLuminanceSampler: AverageLuminance
  - depthStencil: DepthBuffer

############################
- name: Blit
############################
  renderTargets:
  - src: Secondary
  - dst: Main

#############################
#- name: Blit
#############################
#  renderTargets:
#  - src: Secondary
#  - dst: BackBuffer

#############################
#- name: PostProcess
#############################
#  string:
#  - shader: Shaders/ChromaticAberation.shader
#  - defines: ~
#  vec4:
#  - data.offset: [0.00225, 0.00345, 0.00455, 0.0]
#  renderTargets:
#  - color: BackBuffer
#  - depthStencil: DepthBuffer
#  - colorSampler: Secondary

############################
- name: DebugDraw
############################
  renderTargets:
  - color: Main
  - depthStencil: DepthBuffer

############################
- name: DebugView
############################
  string:
  - shader: Shaders/Debug.shader
  renderTargets:
  - src: Main
  - dst: EditorOutput
  - linearDepth: LinearDepth

#############################
- name: RenderImGui
#############################
  renderTargets:
  - color: EditorOutput
  - depthStencil: OverlayDepthBuffer

#############################
- name: EditorReadback
#############################
  renderTargets:
  - src: EditorOutput

#############################
- name: CopyTextureToRam
#############################
  renderTargets:
  - src: Secondary
