<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>SailorEditor</AssemblyName>
    <RootNamespace>SailorEditor</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NuGetAudit>false</NuGetAudit>
    <ApplicationId>com.sailor.editor</ApplicationId>
    <ApplicationTitle>SailorEditor</ApplicationTitle>
    <SailorNativeBuildDirectory Condition="'$(SailorNativeBuildDirectory)' == ''">$(MSBuildThisFileDirectory)../build-linux</SailorNativeBuildDirectory>
    <LinuxEngineLibrary>$(SailorNativeBuildDirectory)/Lib/Sailor-$(Configuration).so</LinuxEngineLibrary>
    <BaseOutputPath>../Binaries/Editor/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
    <PackageReference Include="CommunityToolkit.Maui.Markup" Version="7.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SkiaSharp" Version="2.88.7" />
    <PackageReference Include="YamlDotNet" Version="15.1.1" />
    <PackageReference Update="Microsoft.Maui.Controls.Compatibility" Version="10.0.60" />
    <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4" Version="0.1.0-preview.14.26555.2" />
    <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" Version="0.1.0-preview.14.26555.2" />
    <ProjectReference Include="../Editor/Protocol/SailorEditor.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Editor/**/*.cs"
             Exclude="../Editor/Platforms/**/*.cs;../Editor/McpBridge/**/*.cs;../Editor/Protocol/Generated/**/*.cs;../Editor/Protocol/obj/**/*.cs;../Editor/Protocol/bin/**/*.cs;../Editor/obj/**/*.cs;../Editor/bin/**/*.cs" />
    <MauiXaml Include="../Editor/**/*.xaml" Exclude="../Editor/Platforms/**;../Editor/obj/**;../Editor/bin/**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiImage Include="../Editor/Resources/Images/**" />
    <MauiFont Include="../Editor/Resources/Fonts/*" />
    <MauiIcon Include="../Editor/Resources/AppIcon/appicon.png" />
    <MauiAsset Include="../Editor/Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="$(LinuxEngineLibrary)" Condition="Exists('$(LinuxEngineLibrary)')" Link="Sailor-$(Configuration).so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Using Include="Microsoft.Maui" />
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Microsoft.Maui.Controls.Xaml" />
    <Using Include="Microsoft.Maui.Graphics" />
    <Using Include="Microsoft.Maui.Hosting" />
    <Using Include="Microsoft.Maui.ApplicationModel" />
    <Using Include="Microsoft.Maui.Storage" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
